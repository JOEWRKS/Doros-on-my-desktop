<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Dororong.Core/Dororong.Core.csproj" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <InternalsVisibleTo Include="Dororong.Raster.Tests" />
    <InternalsVisibleTo Include="Dororong.Mac" />
    <InternalsVisibleTo Include="Dororong.Mac.Tests" />
    <Compile Include="../Dororong.App/Interaction/*.cs" Exclude="../Dororong.App/Interaction/CheekPullCapture.cs" Link="Shared/Interaction/%(Filename)%(Extension)" />
    <Compile Include="../Dororong.App/Runtime/PetLoopRuntime.cs" Link="Shared/PetLoopRuntime.cs" />
    <Compile Include="../Dororong.App/Runtime/EdgePerchRuntime.cs" Link="Shared/EdgePerchRuntime.cs" />
    <Compile Include="../Dororong.App/Runtime/ImmutableSnapshotCollection.cs" Link="Shared/ImmutableSnapshotCollection.cs" />
    <Compile Include="../Dororong.App/Runtime/PetPlatformRuntime.cs" Link="Shared/PetPlatformRuntime.cs" />
    <Compile Include="../Dororong.App/Runtime/RuntimeComposition.cs" Link="Shared/RuntimeComposition.cs" />
    <Compile Include="../Dororong.App/Controls/LocomotionPresentation.cs" Link="Shared/LocomotionPresentation.cs" />
    <Compile Include="../Dororong.App/Controls/PounceSession.cs" Link="Shared/PounceSession.cs" />
    <Compile Include="../Dororong.App/Controls/HuntingSession.cs" Link="Shared/HuntingSession.cs" />
    <Compile Include="../Dororong.App/Controls/PerchExpressionMotion.cs" Link="Shared/PerchExpressionMotion.cs" />
    <Compile Include="../Dororong.App/Controls/BodyClickTransformSampler.cs" Link="Shared/BodyClickTransformSampler.cs" />
    <!-- Main sampler is an arithmetic-identical Mac copy with dirty-region
         clear/loop hooks; other sampling parts stay shared. Windows is untouched. -->
    <Compile Include="../Dororong.App/Controls/HighResolutionGrabRaster*.cs" Exclude="../Dororong.App/Controls/HighResolutionGrabRaster.cs;../Dororong.App/Controls/HighResolutionGrabRaster.Flutter.cs" Link="Shared/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets/r104-fixed-paws.bgra.gz" LogicalName="r104-fixed-paws" />
    <Compile Include="../Dororong.App/Controls/HighResolutionBodyInk.cs" Link="Shared/HighResolutionBodyInk.cs" />
    <Compile Include="../Dororong.App/Controls/HighResolutionClosedInk.cs" Link="Shared/HighResolutionClosedInk.cs" />
    <Compile Include="../Dororong.App/Controls/HighResolutionFacePose.cs" Link="Shared/HighResolutionFacePose.cs" />
    <Compile Include="../Dororong.App/Controls/HighResolutionLocomotion.cs" Link="Shared/HighResolutionLocomotion.cs" />
    <Compile Include="../Dororong.App/Controls/HighResolutionHuntNeck.cs" Link="Shared/HighResolutionHuntNeck.cs" />
    <EmbeddedResource Include="Assets/r104-eating.bgra.gz" LogicalName="r104-eating" />
    <Compile Include="../Dororong.App/Controls/RasterAlphaBounds.cs" Link="Shared/RasterAlphaBounds.cs" />
    <Compile Include="../Dororong.App/Controls/RasterRowScheduler.cs" Link="Shared/RasterRowScheduler.cs" />
    <Compile Include="../Dororong.App/Controls/HuntMotion.cs" Link="Shared/HuntMotion.cs" />
    <Compile Include="../Dororong.App/Controls/CheekPullRenderer.cs" Link="Shared/CheekPullRenderer.cs" />
    <EmbeddedResource Include="../Dororong.App/Assets/high-resolution-*.bank" LogicalName="Dororong.App.Assets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Dororong.App/Assets/snack-jewel.png" LogicalName="snack-jewel.png" />
  </ItemGroup>
</Project>
